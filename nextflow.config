conda.enabled = true
conda.useMicromamba = true

params {
    samplesheet = 'assets/samplesheet.csv'
    outdir      = 'results'
    min_overlap = 0.5
    nested_frac = 0.9
    gtf         = null
    oncogenes   = null
    max_genes   = 10
    min_callers = 2
    run_flye    = false
    flye_meta   = false
    reference   = null
    flye_min_overlap = 0.5
    svclone_tol = 300
    conda_env   = '/micromamba_env/ecdna_consensus'
}

process {
    conda = params.conda_env
    executor = 'slurm'
    clusterOptions = '--export=ALL'

    withName: 'PARSE_CALLS|CLUSTER_CALLS|REGIONS_TO_BED|SVCLONE_JUNCTIONS' {
        cpus   = 1
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'EXTRACT_ECDNA' {
        cpus   = 8
        memory = '32 GB'
        time   = '12h'
    }

    withName: 'FLYE' {
        cpus   = 8
        memory = '32 GB'
        time   = '36h'
        queue  = 'long'
        errorStrategy = 'ignore'
    }

    withName: 'EXTRACT_CIRCULAR_CONTIGS' {
        cpus   = 2
        memory = '8 GB'
        time   = '1h'
    }

    withName: 'MINIMAP2_ASSEMBLY_TO_REF' {
        cpus   = 4
        memory = '16 GB'
        time   = '2h'
    }

    withName: 'PLOT_CONSENSUS|PLOT_FLYE|PLOT_SVCLONE' {
        cpus   = 1
        memory = '32 GB'
        time   = '4h'
    }
}

executor {
    $slurm {
        queueSize = 50
        submitRateLimit = '10 sec'
    }
}
